# Copy to .local-reth.env and fill values for the local-reth environment.
# loadEnv(import.meta.url, "local-reth") resolves to ./.local-reth.env.

# Node + chain
RPC_URL=

# Actors
USER_ADDRESS=
USER_PRIVATE_KEY=
CCA_ADDRESS=
CCA_PRIVATE_KEY=

# Owner of the test ERC20 (deployed in 0-setup-erc20.ts)
PRIVATE_KEY=

# ERC20 / vault router
# The asset token MUST implement IReferenceCurrency.isoCode() (e.g. MockUSD
# returns 840 = USD); the Credis Factory reads it to pin the currency rate.
ERC20_ADDRESS=
ERC20_HOLDER_PRIVATE_KEY=
# Owner of the VaultRouter, if not PRIVATE_KEY / ERC20_HOLDER_PRIVATE_KEY (needed to register liquidity sources)
VAULT_ROUTER_PRIVATE_KEY=
VAULT_ROUTER_ADDRESS=

# Smart-account / kernel deployment addresses (Kernel v4 / EntryPoint v0.9)
SMART_ACCOUNT_FACTORY_ADDRESS=
ENTRYPOINT_ADDRESS=
BUNDLE_MODULE_PLUGIN_ADDRESS=

# Precompile address overrides. All optional - each falls back to the canonical
# address in src/utils.ts, so leave them blank unless the chain moved one.
GRATIS_ADDRESS=
GRATIS_FACTORY_ADDRESS=
PROMIS_ADDRESS=
PROMIS_FACTORY_ADDRESS=
GEM_ADDRESS=
GEM_FACTORY_ADDRESS=
CREDIS_ADDRESS=
CREDIS_FACTORY_ADDRESS=
FIDELITY_ADDRESS=
