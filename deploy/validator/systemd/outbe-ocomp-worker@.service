[Unit]
Description=Outbe OCOMP worker %i
After=outbe-full-node.service outbe-validator.service
PartOf=outbe-full-node.service outbe-validator.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=outbe
Group=outbe
EnvironmentFile=/opt/outbe-chain/validator.env
Environment=OUTBE_OCOMP_BASE_PATH=/opt/outbe-chain
Environment=OCOMP_VALIDATOR_INDEX=0
Environment=OUTBE_OCOMP_RPC_URL=http://127.0.0.1:8545
ExecStart=/opt/outbe-chain/outbe-ocomp worker \
  --chain-id ${OCOMP_CHAIN_ID} \
  --genesis-hash ${OCOMP_GENESIS_HASH} \
  --boot-nonce ${OCOMP_BOOT_NONCE} \
  --worker-ordinal %i \
  --protocol-bundle-hash ${OCOMP_PROTOCOL_BUNDLE_HASHES} \
  --supervisor-address 127.0.0.1:30401
Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60
TimeoutStopSec=90
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/outbe-chain/validator-0

[Install]
WantedBy=outbe-full-node.service outbe-validator.service
