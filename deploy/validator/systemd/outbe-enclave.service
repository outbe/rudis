[Unit]
Description=Outbe TEE enclave
After=network-online.target aesmd.service
Wants=network-online.target
Requires=aesmd.service
PartOf=outbe-validator.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
EnvironmentFile=/opt/outbe-chain/validator.env
ExecStart=/opt/outbe-chain/deploy/validator/outbe-validator-service.py enclave
Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/outbe-chain/tee
BindReadOnlyPaths=-/opt/outbe-chain/sgx:/opt/outbe/sgx
BindPaths=/opt/outbe-chain/tee:/var/lib/outbe/tee

[Install]
WantedBy=outbe-validator.target
