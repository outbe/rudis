# Outbe network RPC used by Hardhat and deployment scripts.
OUTBE_RPC_URL=
OUTBE_PRIVATE_KEY=0x...

# BSC Testnet
BSC_TESTNET_RPC_URL=https://bsc-testnet.publicnode.com
BSC_TESTNET_PRIVATE_KEY=0x...

# BSC Mainnet
BSC_MAINNET_RPC_URL=https://bsc-dataseed1.binance.org
BSC_MAINNET_PRIVATE_KEY=0x...

# ETH Sepolia
SEPOLIA_RPC_URL=https://sepolia.publicnode.com
SEPOLIA_PRIVATE_KEY=0x...

# ether scan (for verification)
ETHERSCAN_API_KEY=XYZ123...

# [required] CREATE3 factory, deployed once from contracts/shared (mise run deploy-create3-factory there)
CREATE3_FACTORY_ADDRESS=

# [optional] Whitelist registry gating who may commit bids; unset leaves commitBid ungated
WHITELIST_ADDRESS=
