# Deployment configuration for the token routes (USDT and WCOEN).
# Tags are relative to `mise run deploy-all`:
#   [required] - must be set for deploy-all
#   [optional] - has a default, or only needed by specific steps

# [required] Network to deploy on - an alias from [rpc_endpoints] in foundry.toml:
#            outbe-testnet, outbe-dev, outbe-privnet, bsc-testnet, sepolia, local.
#            The `sepolia` and `ethereum` aliases resolve ${SEPOLIA_RPC_URL} / ${ETHEREUM_RPC_URL}, so set those too.
NETWORK=bsc-testnet
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# [required] Deployer private key. It signs every owner-only call AND is part of every CREATE3 salt, so all chains
#            must be deployed from this same key or the addresses diverge.
DEPLOYER_PK=
# [required] Salt for deterministic (CREATE3) deployment - keep identical across chains for a shared address
CONTRACT_SALT=
# [required] Local ERC-7786 bridge hub facade (differs per chain; does not affect any address)
BRIDGE_ADDRESS=
# [required] Chain id of Outbe. Decides which side of each route is canonical on the connected chain.
OUTBE_CHAIN_ID=70860602
# [required] Chain id of the external chain this deployment targets - 97 (BNB testnet), 11155111 (Sepolia), ...
EXTERNAL_CHAIN_ID=97

# [optional] Token and bridge admin. Defaults to the deployer; must be a contract (Safe) on the declared chains.
OWNER_ADDRESS=
# [optional] Emergency override: allow an EOA owner on a declared chain
ALLOW_EOA_OWNER=false
# [required] CREATE3 factory, deployed once from contracts/shared (mise run deploy-create3-factory there)
CREATE3_FACTORY_ADDRESS=
# [optional] Chains to wire as remotes, csv. The same list works on every chain - the local id is skipped.
REMOTE_CHAIN_IDS=97,11155111,70860602

# [optional] Adopt a canonical token that already exists on its own chain instead of deploying one - the issuer's
#            USDT on a real network, or a WCOEN deployed on Outbe outside this script. Read only on the chain where
#            that route is canonical. This is the one case where a token address is not shared across chains; the
#            bridge address stays identical regardless.
CANONICAL_USDT_TOKEN=
CANONICAL_USDC_TOKEN=
CANONICAL_WCOEN_TOKEN=
# [required on Outbe] The USDC stablecoin issued by the stablecoin factory. That route has no synthetic to deploy -
#                     governance creates the token - so the USDC deploy fails on Outbe until this names it.
SYNTHETIC_USDC_TOKEN=

# [optional] Mock USDT bootstrap on the external chain
INITIAL_MINT_AMOUNT=
INITIAL_MINT_RECIPIENT=

# [Send.s.sol only] Which route ("usdt" | "wcoen"), where to, to whom, how much (in the token's own decimals).
ROUTE=usdt
DEST_CHAIN_ID=
RECIPIENT=
SEND_AMOUNT_LD=
